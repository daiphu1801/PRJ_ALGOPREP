# AlgoPrep backend — chốt kiểu xuống dòng.
#
# Vì sao cần file này: máy phát triển hiện tại có `core.autocrlf=true`, nên nếu không khai gì thì
# git sẽ đổi LF thành CRLF lúc checkout. Spotless được cấu hình `lineEndings=UNIX` (LF) trong
# pom.xml, nên hai bên sẽ đánh nhau: vừa `git clone` xong là `./mvnw verify` đỏ ở cổng định dạng,
# trên một cây mã không ai sửa gì. `eol=lf` ở đây thắng `core.autocrlf`, nên cả hai cùng nói LF.

*.java   text eol=lf
*.xml    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.sql    text eol=lf
*.properties text eol=lf

# mvnw là shell script. CRLF ở đây làm nó chết trên Linux và trong container với thông báo lỗi vô
# nghĩa ("bad interpreter: No such file or directory"), nên đây không phải chuyện thẩm mỹ.
mvnw     text eol=lf
# mvnw.cmd thì ngược lại: batch script của Windows cần CRLF.
mvnw.cmd text eol=crlf
