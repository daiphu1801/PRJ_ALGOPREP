<?xml version="1.0" encoding="UTF-8"?>
<!--
  algoprep-identity — Bounded Context `identity` (F1), schema PostgreSQL `identity`.

  Chi phu thuoc algoprep-common. KHONG phu thuoc module nghiep vu nao khac
  (01-rd/system/SYS0101_backend_architecture.md muc 2.A luat 1) — ArchUnit trong algoprep-bootstrap chan that.

  Trang thai: khung base, chua co class nghiep vu. Noi dung cho BD/DD cua module nay
  (02-bd/ + 03-dd/). Xem 05-coding/backend/README.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.algoprep</groupId>
    <artifactId>algoprep-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>algoprep-identity</artifactId>
  <name>algoprep-identity</name>
  <description>Danh tính và phân quyền (F1)</description>

  <properties>
    <!-- Coverage gate is blocking here: 87% measured 2026-10-31 (threshold stays 80%, parent pom). -->
    <jacoco.haltOnFailure>true</jacoco.haltOnFailure>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.data</groupId>
      <artifactId>spring-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.algoprep</groupId>
      <artifactId>algoprep-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Task F1 #5: JWT RS256 (Nimbus via Spring Security), per-request permission lookup via JDBC. -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-config</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-oauth2-jose</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
    </dependency>
    <!-- Parses the JSONB class schedule into an object for the student class endpoints. -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- Controllers of this module (presentation layer). -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-webmvc</artifactId>
    </dependency>
    <!-- Class events (ClassDeleted, StudentRemovedFromClass) go out through RabbitTemplate. -->
    <dependency>
      <groupId>org.springframework.amqp</groupId>
      <artifactId>spring-rabbit</artifactId>
    </dependency>
  </dependencies>
</project>
