{
  "id": null,
  "uid": "algoprep-load-hikari",
  "title": "AlgoPrep · Hikari pools",
  "description": "Local acceptance dashboard. Choose the isolated 8081 backend or the normal 8080 backend; a zero gauge is valid, missing data is not a measured zero.",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "algoprep",
    "hikari",
    "acceptance"
  ],
  "editable": false,
  "refresh": "5s",
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "backend_job",
        "label": "Backend job",
        "type": "custom",
        "query": "algoprep-load-backend,algoprep-backend",
        "current": {
          "selected": true,
          "text": "algoprep-load-backend",
          "value": "algoprep-load-backend"
        },
        "options": [
          {
            "selected": true,
            "text": "algoprep-load-backend",
            "value": "algoprep-load-backend"
          },
          {
            "selected": false,
            "text": "algoprep-backend",
            "value": "algoprep-backend"
          }
        ],
        "includeAll": false,
        "multi": false,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Active connections",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "algoprep-load-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "algoprep-load-prometheus"
          },
          "editorMode": "code",
          "expr": "hikaricp_connections_active{job=\"$backend_job\"}",
          "legendFormat": "{{pool}}",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Pending requests for a connection",
      "type": "timeseries",
