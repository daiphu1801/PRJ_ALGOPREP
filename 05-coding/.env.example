# AlgoPrep — bien moi truong cho ha tang local.
#
# Sao chep thanh `.env` roi doi mat khau truoc khi chay lan dau:
#   cp .env.example .env
#
# `.env` da nam trong .gitignore (dong 20). File nay (`.env.example`) duoc track co chu dich
# (.gitignore dong 26: `!.env.example`) — no la tai lieu ve nhung bien can co, nen KHONG duoc chua
# gia tri thuc.
#
# Moi bien mat khau o duoi khong co gia tri mac dinh trong docker-compose.yml: thieu la compose
# BAO LOI NGAY thay vi khoi dong voi mot mat khau doan duoc. Do la chu dich.

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=algoprep
POSTGRES_USER=algoprep
POSTGRES_PASSWORD=doi-mat-khau-nay
# CANH BAO VE XUNG DOT CONG - da gap that tren may phat trien ngay 2026-09-01.
#
# Neu may da co PostgreSQL cai native, no giu cong 5432 va Docker proxy se cung listen 5432 nhung
# THUA: moi ket noi tu host di vao ban native. Trieu chung KHONG he goi ten cong:
#   FATAL: password authentication failed for user "algoprep"
# Doc len tuong nhu sai mat khau, thuc ra la dang noi voi mot server khac.
#
# Kiem:  netstat -ano | grep ":5432 "     -> nhieu hon mot PID la co xung dot
# Sua:   doi POSTGRES_PORT VA ALGOPREP_DB_PORT (o cuoi file) sang 5433, roi
#        docker compose up -d --force-recreate postgres
POSTGRES_PORT=5432

# --- Redis --------------------------------------------------------------------
REDIS_PASSWORD=doi-mat-khau-nay
REDIS_PORT=6379

# --- Mailpit (local SMTP sink) ------------------------------------------------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
ALGOPREP_SMTP_HOST=localhost
ALGOPREP_SMTP_PORT=1025
ALGOPREP_MAIL_FROM=noreply@algoprep.local

# --- Tai khoan ADMIN dau tien (DD BR-23, JOB-ID-01) ----------------------------
# Bat buoc khi DB chua co ADMIN nao, thieu mot trong hai thi ung dung KHONG khoi dong.
# Da co ADMIN thi hai bien nay bi bo qua (doi mat khau o day khong co tac dung).
# Mat khau: >= 8 ky tu, co chu va so, toi da 72 byte UTF-8. Lan dang nhap dau bat buoc doi mat khau.
ALGOPREP_BOOTSTRAP_ADMIN_EMAIL=admin@algoprep.local
ALGOPREP_BOOTSTRAP_ADMIN_PASSWORD=doi-mat-khau-nay-123

# --- RabbitMQ -----------------------------------------------------------------
RABBITMQ_USER=algoprep
RABBITMQ_PASSWORD=doi-mat-khau-nay
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- MinIO --------------------------------------------------------------------
MINIO_ROOT_USER=algoprep
# MinIO yeu cau toi thieu 8 ky tu.
MINIO_ROOT_PASSWORD=doi-mat-khau-nay
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_TESTCASE=algoprep-testcases
# Backend storage credentials; load these into the backend process environment.
ALGOPREP_MINIO_ENDPOINT=http://localhost:9000
ALGOPREP_MINIO_PUBLIC_ENDPOINT=http://localhost:9000
ALGOPREP_MINIO_ACCESS_KEY=algoprep
ALGOPREP_MINIO_SECRET_KEY=doi-mat-khau-nay

# --- go-judge -----------------------------------------------------------------
GO_JUDGE_PORT=5050
GO_JUDGE_MONITOR_PORT=5052
# So lenh chay song song trong sandbox. Dat theo so core thuc; qua cao thi cac bai nop lam nhieu
# nhau ve thoi gian va ket qua TLE mat y nghia.
GO_JUDGE_PARALLELISM=4

# --- Giam sat (profile `observability`) ---------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_USER=admin
GRAFANA_PASSWORD=doi-mat-khau-nay
# 3001 chu khong phai 3000: 3000 danh cho `next dev` cua frontend.
GRAFANA_PORT=3001

# --- Bien phia BACKEND (JVM doc, khong phai docker compose) -------------------
# Ba khoi tren la cho DOCKER COMPOSE. Khoi nay la cho UNG DUNG Spring Boot khi chay profile
# `local` (05-coding/backend/algoprep-bootstrap/src/main/resources/application-local.yml).
#
# LUU Y: Spring Boot KHONG doc file .env nay. Phai export chung ra moi truong truoc khi chay:
#   set -a; source .env; set +a          # bash / git bash
#   ./mvnw -pl algoprep-bootstrap spring-boot:run -Dspring-boot.run.profiles=local
#
# Gia tri phai KHOP voi khoi docker compose o tren. Doi POSTGRES_PORT thi phai doi ca
# ALGOPREP_DB_PORT — hai bien, mot su that, va do la cho de lech nhat trong file nay.
ALGOPREP_DB_HOST=localhost
ALGOPREP_DB_PORT=5432
ALGOPREP_DB_NAME=algoprep
ALGOPREP_DB_USER=algoprep
ALGOPREP_DB_PASSWORD=doi-mat-khau-nay

ALGOPREP_REDIS_HOST=localhost
ALGOPREP_REDIS_PORT=6379
ALGOPREP_REDIS_PASSWORD=doi-mat-khau-nay

ALGOPREP_RABBITMQ_HOST=localhost
ALGOPREP_RABBITMQ_PORT=5672
ALGOPREP_RABBITMQ_USER=algoprep
ALGOPREP_RABBITMQ_PASSWORD=doi-mat-khau-nay

ALGOPREP_GO_JUDGE_URL=http://localhost:5050

# --- Dang nhap bang GitHub / Google (F1 #5, #6) ---------------------------------------
# De trong = tat nha cung cap do (redirect tra 503 IDT-505). Tao OAuth App roi dien client id/secret.
# URL goi lai da dang ky o nha cung cap: <ALGOPREP_OAUTH_REDIRECT_BASE_URL>/auth/callback/github
# va .../auth/callback/google.
ALGOPREP_OAUTH_REDIRECT_BASE_URL=http://localhost:3000
ALGOPREP_OAUTH_GITHUB_CLIENT_ID=
ALGOPREP_OAUTH_GITHUB_CLIENT_SECRET=
ALGOPREP_OAUTH_GOOGLE_CLIENT_ID=
ALGOPREP_OAUTH_GOOGLE_CLIENT_SECRET=

# --- Nha cung cap LLM (F5, F6) ------------------------------------------------
# Provider: OpenRouter (OpenAI-compatible), called through Spring AI (DEC-2026-1108-llm-provider-openrouter-free-models).
# The API key lives only here (backend infrastructure), never in the database or the UI
# (DEC-2026-1010-admin-selects-model-per-prompt).
ALGOPREP_AI_OPENROUTER_API_KEY=
ALGOPREP_AI_BASE_URL=https://openrouter.ai/api
# Fallback model id. The seed alias 'default' (always allowed, always listed first) resolves to this id;
# blank means any call that needs it fails like a missing API key (DEC-2026-1112-ai-model-alias-default-always-allowed).
ALGOPREP_AI_DEFAULT_MODEL=
# Comma-separated model ids the admin may pick per prompt on ADM0301 (ai.models.allowed).
# The alias 'default' is always allowed and needs no entry here.
ALGOPREP_AI_ALLOWED_MODELS=
