# Real backend through the same-origin proxy in next.config.ts (no CORS, cookies work as designed):
# NEXT_PUBLIC_API_BASE_URL=/api/v1
# API_PROXY_TARGET=http://localhost:8080
# Calling the backend directly from the browser needs CORS on the backend, which is not configured.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
# NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8080/ws

# PROTOTYPE — no DD yet. See 06-plan/PROTOTYPE_DEBT.md
# true  = every entity api reads from entities/<x>/api/__mock__/ (no backend needed)
# false = calls the real backend via shared/api/client.ts
NEXT_PUBLIC_MOCK_DATA=true
