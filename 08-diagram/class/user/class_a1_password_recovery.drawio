        <mxCell id="title" value="A1 — Khôi phục mật khẩu bằng mã xác nhận" style="text;html=1;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1A1A1A;" vertex="1" parent="1">
