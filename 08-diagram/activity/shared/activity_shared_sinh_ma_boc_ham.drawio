        </mxCell>
        <mxCell id="v2" value="Nhận đặc tả hàm, mã người học và mô hình nộp bài đang chọn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#1A1A1A;fontSize=11;fontStyle=1;" vertex="1" parent="1">
