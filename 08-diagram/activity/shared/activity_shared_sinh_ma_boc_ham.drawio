        <mxCell id="title" value="Sơ đồ hoạt động - Sinh mã bọc hàm, ánh xạ lỗi biên dịch và so khớp kết quả (F3)" style="text;html=1;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1A1A1A;" vertex="1" parent="1">
